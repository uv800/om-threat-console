# ── OM AI analyst (server-side only, via server.js) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
OM_MODEL=claude-sonnet-4-6
# OM_PORT=8787

# ── Investigation / enrichment sources (server-side, NO VITE_ prefix) ───────
# With none set, /api/enrich returns clearly-flagged DEMO data so the console
# still works. Add any/all to enable real lookups.
# VIRUSTOTAL_API_KEY=your-vt-key       # https://www.virustotal.com/gui/my-apikey
# ABUSEIPDB_API_KEY=your-abuseipdb-key # https://www.abuseipdb.com/account/api
# SHODAN_API_KEY=your-shodan-key       # https://account.shodan.io

# ── Frontend endpoint overrides (optional) ─────────────────────────────────
# VITE_OM_ENDPOINT=/api/om
# VITE_ENRICH_ENDPOINT=/api/enrich

# ── LIVE dashboard feeds (separate from investigation; off by default) ──────
VITE_USE_LIVE_FEEDS=false
# VITE_NVD_API_KEY=your-nvd-key
# VITE_SHODAN_API_KEY=your-shodan-key
# VITE_MISP_URL=https://misp.your-org.tld
# VITE_MISP_KEY=your-misp-auth-key
